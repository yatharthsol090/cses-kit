# CSES credentials. Only one method is needed.

# Preferred: import a browser session cookie. Log in at https://cses.fi,
# open DevTools -> Application -> Cookies -> cses.fi, copy PHPSESSID.
# Then run: cses login --session <PHPSESSID>
# CSES_PHPSESSID=

# Deprecated: plaintext password. Kept for backwards compatibility; a
# valid session cookie makes it unused.
# CSES_NICK=
# CSES_PASS=
